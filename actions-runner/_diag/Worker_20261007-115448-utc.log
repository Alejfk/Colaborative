              "line": 13,
              "col": 14,
              "lit": "Write-Host \"Usuario ejecutando el runner: $env:USERNAME\"\n\n# 1. Comprobar presencia de tokens\n$tieneLocal = -not [string]::IsNullOrWhiteSpace($env:LOCAL_DEV_TOKEN)\n$tieneSecret = -not [string]::IsNullOrWhiteSpace($env:DEV_TOKEN)\n\n# Si el runner no heredó la variable en su sesión, buscar en el registro del Sistema\nif (-not $tieneLocal) {\n    $machineVal = [System.Environment]::GetEnvironmentVariable('LOCAL_DEV_TOKEN', [System.EnvironmentVariableTarget]::Machine)\n    if (-not [string]::IsNullOrWhiteSpace($machineVal)) {\n        $env:LOCAL_DEV_TOKEN = $machineVal\n        $tieneLocal = $true\n    }\n}\n\nif (-not $tieneLocal -or -not $tieneSecret) {\n    Write-Host \"Error: Falta LOCAL_DEV_TOKEN o DEV_TOKEN en el entorno.\" -ForegroundColor Red\n    exit 1\n}\n\n# 2. Comparación\nif ($env:DEV_TOKEN -ceq $env:LOCAL_DEV_TOKEN) {\n    Write-Host \"Validacion exitosa: Los tokens coinciden perfectamente.\" -ForegroundColor Green\n} else {\n    Write-Host \"Error: Los valores de los tokens son distintos.\" -ForegroundColor Red\n    exit 1\n}\n"
            }
          },
